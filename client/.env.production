# Production build (Vercel). Empty on purpose: the browser calls /api/... and /uploads/... on the site itself, and
# vercel.json forwards them to the Render server, so the login cookies stay first-party. No secrets in this file.
# VITE_SITE_URL and VITE_DEMO_PASSWORD are set in the Vercel dashboard (DEPLOY.txt 2.4).
VITE_API_URL=
