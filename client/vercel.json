{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lumen-api-qblx.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://lumen-api-qblx.onrender.com/uploads/:path*" },
    { "source": "/robots.txt", "destination": "https://lumen-api-qblx.onrender.com/robots.txt" },
    { "source": "/sitemap.xml", "destination": "https://lumen-api-qblx.onrender.com/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
